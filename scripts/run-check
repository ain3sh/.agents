#!/usr/bin/env python3
"""Run one check attached, mirror every byte to a bounded log, forward signals."""

from __future__ import annotations

import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import BinaryIO, Callable

MAX_LOG_FILES = 50
READ_SIZE = 64 * 1024
TERMINATION_GRACE_SECONDS = 1.0
LOCK_POLL_SECONDS = 2.0
EXCLUSIVE_SLOTS = 2
_EXCLUSIVE_LOCK_BASE = os.environ.get(
    "DROID_CHECK_LOCK_PATH", f"/tmp/droid-checks-{os.getuid()}.exclusive.lock"
)
EXCLUSIVE_LOCK_PATHS = tuple(
    Path(f"{_EXCLUSIVE_LOCK_BASE}.{slot}") for slot in range(EXCLUSIVE_SLOTS)
)
_ENV_NAME_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
_SLUG_RE = re.compile(r"[^a-z0-9._-]+")
_TEST_FILE_RE = re.compile(r"\.(?:test|spec)\.[cm]?[jt]sx?$")
_FAST_LINTERS = frozenset({"oxlint", "oxfmt"})
_MAX_LIGHT_TEST_FILES = 4


@dataclass(frozen=True, slots=True)
class Options:
    label: str
    cwd: str | None
    env: dict[str, str]
    unset_prefixes: tuple[str, ...]
    exclusive: bool
    command: list[str]


def _read_env_file(path: str) -> dict[str, str]:
    """Load KEY=VALUE pairs from a JSON object or dotenv file without echoing them."""
    text = Path(path).expanduser().read_text()
    loaded: dict[str, str] = {}
    stripped = text.lstrip()
    if stripped.startswith("{"):
        try:
            entries = json.loads(stripped)
        except ValueError as exc:
            raise OSError(f"{path}: invalid JSON ({exc})") from exc
        for name, value in entries.items():
            if not isinstance(value, str) or _ENV_NAME_RE.fullmatch(name) is None:
                raise OSError(f"{path}: {name!r} is not a string environment entry")
            loaded[name] = value
        return loaded
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export ") :]
        if "=" not in line:
            raise OSError(f"{path}: expected KEY=VALUE, found {line.split()[0]!r}")
        name, value = line.split("=", 1)
        if _ENV_NAME_RE.fullmatch(name) is None:
            raise OSError(f"{path}: invalid environment name {name!r}")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        loaded[name] = value
    return loaded


def _error_status(exc: OSError) -> int:
    return 127 if isinstance(exc, FileNotFoundError) else 1


def _usage() -> None:
    print(
        "usage: run-check <label> [--cwd <directory>] "
        "[--env KEY=VALUE]... [--env-file <path>]... [--unset-prefix <prefix>]... "
        "[--exclusive] -- <command> [args...]",
        file=sys.stderr,
    )
    raise SystemExit(64)


def _parse(argv: list[str]) -> Options:
    if len(argv) < 3:
        _usage()

    label = argv[0]
    cwd: str | None = None
    env: dict[str, str] = {}
    unset_prefixes: list[str] = []
    exclusive = False
    index = 1

    while index < len(argv):
        token = argv[index]
        if token == "--":
            command = argv[index + 1 :]
            if not command:
                _usage()
            return Options(label, cwd, env, tuple(unset_prefixes), exclusive, command)
        if token == "--env-file":
            if index + 1 >= len(argv):
                _usage()
            try:
                env.update(_read_env_file(argv[index + 1]))
            except OSError as exc:
                print(f"[run-check] error: {exc}", file=sys.stderr)
                raise SystemExit(_error_status(exc)) from exc
            index += 2
            continue
        if token == "--unset-prefix":
            if index + 1 >= len(argv) or not argv[index + 1]:
                _usage()
            unset_prefixes.append(argv[index + 1])
            index += 2
            continue
        if token == "--exclusive":
            exclusive = True
            index += 1
            continue
        if token == "--cwd":
            if index + 1 >= len(argv):
                _usage()
            cwd = argv[index + 1]
            index += 2
            continue
        if token == "--env":
            if index + 1 >= len(argv) or "=" not in argv[index + 1]:
                _usage()
            name, value = argv[index + 1].split("=", 1)
            if _ENV_NAME_RE.fullmatch(name) is None:
                _usage()
            env[name] = value
            index += 2
            continue
        _usage()
    _usage()


def _log_dir() -> Path:
    path = Path(os.environ.get("DROID_CHECK_LOG_DIR", "/tmp/droid-checks"))
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    return path


def _prune_logs(log_dir: Path) -> None:
    logs: list[tuple[float, Path]] = []
    for path in log_dir.glob("*.log"):
        try:
            logs.append((path.stat().st_mtime, path))
        except FileNotFoundError:
            pass
    logs.sort(key=lambda item: item[0], reverse=True)
    for _mtime, path in logs[MAX_LOG_FILES:]:
        try:
            path.unlink()
        except FileNotFoundError:
            pass


def _create_log(log_dir: Path, label: str) -> tuple[Path, object]:
    slug = _SLUG_RE.sub("-", label.lower()).strip("-") or "check"
    with (log_dir / ".lock").open("a+b") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        descriptor, raw_path = tempfile.mkstemp(
            prefix=f"{slug}.",
            suffix=".log",
            dir=log_dir,
        )
        _prune_logs(log_dir)
    return Path(raw_path), os.fdopen(descriptor, "wb", buffering=0)


def _is_light(command: list[str]) -> bool:
    """A few named vitest files or a Rust linter skip the host's heavy-check slots.

    Anything unrecognized stays heavy: type-aware lint holds ~5.5 GB, package
    scripts and turbo runs can fan out to whole suites or builds, and benches
    and E2E runs need a quiet host. The file cap bounds vitest
    workers (one per file) so concurrent light checks cannot exhaust RAM.
    """
    if any(word in token for token in command for word in ("bench", "e2e", "typecheck")):
        return False
    names = {Path(token).name for token in command}
    if names & _FAST_LINTERS:
        return True
    test_files = sum(1 for token in command if _TEST_FILE_RE.search(token))
    return "vitest" in names and 0 < test_files <= _MAX_LIGHT_TEST_FILES


def _lock_holder(lock: BinaryIO) -> dict[str, object] | None:
    """The holder's own record from the lock file, or None if it wrote none."""
    lock.seek(0)
    try:
        holder = json.loads(lock.read())
    except ValueError:
        return None
    return holder if isinstance(holder, dict) else None


def _describe_holder(holder: dict[str, object] | None) -> str:
    if holder is None:
        return "another check"
    elapsed = int(time.time() - float(holder.get("started", time.time())))
    where = Path(str(holder.get("cwd", ""))).name or "?"
    return (
        f"{holder.get('label', '?')} ({where}, pid {holder.get('pid', '?')}, "
        f"running {elapsed // 60}m{elapsed % 60:02d}s)"
    )


def _try_slots(slots: list[BinaryIO]) -> BinaryIO | None:
    for slot in slots:
        try:
            fcntl.flock(slot, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            continue
        return slot
    return None


def _acquire_exclusive(options: Options, emit: Callable[[str], None]) -> BinaryIO:
    """Queue for a host slot, naming the checks ahead each time they change.

    Holders record themselves in their slot file so waiters can show who they
    are behind; a blocking flock would look identical to a hang.
    """
    waited_since = time.monotonic()
    shown: list[tuple[object, object]] | None = None
    slots = [path.open("a+b") for path in EXCLUSIVE_LOCK_PATHS]
    lock: BinaryIO | None = None
    try:
        while (lock := _try_slots(slots)) is None:
            holders = [_lock_holder(slot) for slot in slots]
            keys = [((h or {}).get("pid"), (h or {}).get("label")) for h in holders]
            if keys != shown:
                ahead = "; ".join(_describe_holder(h) for h in holders)
                emit(f"[run-check] exclusive: waiting behind {ahead}\n")
                shown = keys
            time.sleep(LOCK_POLL_SECONDS)
    finally:
        for slot in slots:
            if slot is not lock:
                slot.close()
    waited = int(time.monotonic() - waited_since)
    lock.truncate(0)
    lock.write(
        json.dumps(
            {
                "label": options.label,
                "cwd": options.cwd or os.getcwd(),
                "pid": os.getpid(),
                "started": time.time(),
            }
        ).encode()
    )
    lock.flush()
    emit(f"[run-check] exclusive: acquired after {waited // 60}m{waited % 60:02d}s\n")
    return lock


def _status(returncode: int) -> int:
    return 128 + -returncode if returncode < 0 else returncode


def _terminate_group(child: subprocess.Popen[bytes], signum: int) -> None:
    try:
        os.killpg(child.pid, signum)
    except ProcessLookupError:
        return

    deadline = time.monotonic() + TERMINATION_GRACE_SECONDS
    while time.monotonic() < deadline:
        child.poll()
        try:
            os.killpg(child.pid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.05)
    try:
        os.killpg(child.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def _write(stream: object, log: object, data: bytes) -> None:
    stream.write(data)
    stream.flush()
    log.write(data)


def _nearest_nvmrc(cwd: str | None) -> Path | None:
    directory = Path(cwd or os.getcwd()).resolve()
    for candidate in (directory, *directory.parents):
        nvmrc = candidate / ".nvmrc"
        if nvmrc.is_file():
            return nvmrc
    return None


def _node_command(
    command: list[str],
    cwd: str | None,
    env: dict[str, str],
) -> tuple[list[str], str | None]:
    nvmrc = _nearest_nvmrc(cwd)
    if nvmrc is None:
        return command, None

    nvm_dir = Path(env.get("NVM_DIR", str(Path.home() / ".nvm"))).expanduser()
    nvm_exec = nvm_dir / "nvm-exec"
    if not nvm_exec.is_file():
        raise FileNotFoundError(
            f"{nvmrc} requires NVM, but {nvm_exec} does not exist; "
            f"install NVM, run `nvm install` in {nvmrc.parent}, then rerun this check"
        )

    selector = nvmrc.read_text().strip()
    if not selector:
        raise OSError(f"{nvmrc} is empty")

    env["NODE_VERSION"] = selector
    return [
        str(nvm_exec),
        "env",
        "-u",
        "NODE_VERSION",
        *command,
    ], f"{selector} ({nvmrc})"


def _run(options: Options) -> int:
    log_dir = _log_dir()
    log_path, log = _create_log(log_dir, options.label)
    stdout = sys.stdout.buffer

    def emit(message: str) -> None:
        _write(stdout, log, message.encode())

    emit(f"[run-check] log: {log_path}\n")

    env = {
        name: value
        for name, value in os.environ.items()
        if not name.startswith(options.unset_prefixes)
    }
    env.update(options.env)
    child: subprocess.Popen[bytes] | None = None
    received_signal: int | None = None

    def forward(signum: int, _frame: object) -> None:
        nonlocal received_signal
        received_signal = signum
        if child is None:
            raise InterruptedError("check interrupted before validator startup")
        _terminate_group(child, signum)

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, forward)

    lock: BinaryIO | None = None
    try:
        if options.exclusive and _is_light(options.command):
            emit("[run-check] exclusive: skipped (targeted tests or fast linter)\n")
        elif options.exclusive:
            lock = _acquire_exclusive(options, emit)
        command, node_version = _node_command(
            options.command,
            options.cwd,
            env,
        )
        if node_version is not None:
            emit(f"[run-check] node: {node_version}\n")
        child = subprocess.Popen(
            command,
            cwd=options.cwd,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        assert child.stdout is not None
        while chunk := os.read(child.stdout.fileno(), READ_SIZE):
            _write(stdout, log, chunk)
        returncode = child.wait()
        status = (
            128 + received_signal
            if received_signal is not None
            else _status(returncode)
        )
    except InterruptedError:
        if received_signal is None:
            raise
        status = 128 + received_signal
    except OSError as exc:
        emit(f"[run-check] error: {exc}\n")
        status = _error_status(exc)
    finally:
        if child is not None:
            if child.stdout is not None:
                child.stdout.close()
            if child.poll() is None:
                _terminate_group(child, signal.SIGTERM)
                child.wait()
        if lock is not None:
            lock.truncate(0)
            lock.close()
    emit(f"[run-check] exit: {status}\n")
    log.close()
    return status


def main() -> int:
    return _run(_parse(sys.argv[1:]))


if __name__ == "__main__":
    raise SystemExit(main())
