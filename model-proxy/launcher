#!/usr/bin/env python3

import base64
import hashlib
import json
import os
import re
import sys
from pathlib import Path


HOME = Path.home()
DEFAULT_SOURCE = HOME / ".agents/model-proxy/config.yaml"
PROMPTS = HOME / ".agents/prompts"
BINARY = HOME / ".local/bin/cli-proxy-api"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/cli-model-proxy-{os.getuid()}")) / "cli-model-proxy"
PLACEHOLDER = re.compile(r"\$\{([^}]+)\}")


def escaped(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)[1:-1]


def substitute(match: re.Match[str]) -> str:
    expression = match.group(1)
    if expression.startswith("ENV:"):
        return escaped(os.environ.get(expression[4:], ""))

    encode = expression.endswith(":base64")
    path_text = expression[:-7] if encode else expression
    path = Path(path_text).expanduser()
    if not path.is_absolute():
        path = PROMPTS / path

    if encode:
        return base64.b64encode(path.read_bytes()).decode()
    return escaped(path.read_text())


def parse_args() -> tuple[Path, list[str]]:
    args = sys.argv[1:]
    source = Path(os.environ.get("CLIPROXY_CONFIG", DEFAULT_SOURCE)).expanduser()
    for option in ("--config", "-c"):
        if option in args:
            index = args.index(option)
            try:
                source = Path(args[index + 1]).expanduser()
            except IndexError:
                raise SystemExit(f"{option} requires a YAML path")
            del args[index : index + 2]
            break
    return source.resolve(), args


def main() -> None:
    source, args = parse_args()
    rendered = "".join(
        line if line.lstrip().startswith("#") else PLACEHOLDER.sub(substitute, line)
        for line in source.read_text().splitlines(keepends=True)
    )
    RUNTIME_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    RUNTIME_DIR.chmod(0o700)
    digest = hashlib.sha256(str(source).encode()).hexdigest()[:16]
    runtime_config = RUNTIME_DIR / f"{digest}.yaml"
    runtime_config.write_text(rendered)
    runtime_config.chmod(0o600)
    os.execv(BINARY, [str(BINARY), "-config", str(runtime_config), *args])


if __name__ == "__main__":
    main()
